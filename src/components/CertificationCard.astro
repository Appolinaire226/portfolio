---
interface Props {
  title: string;
  issuer: string;
  date: string;
  description: string;
  certificateUrl?: string;
}

const {
  title,
  issuer,
  date,
  description,
  certificateUrl,
} = Astro.props;
---

<article
  class="card-hover flex h-full flex-col rounded-xl border border-slate-800 bg-slate-900 p-6"
  class="flex h-full flex-col rounded-xl border border-slate-800 bg-slate-900 p-6"
>
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-cyan-400">
        Certification
      </p>

      <h2 class="mt-3 text-2xl font-semibold text-white">
        {title}
      </h2>
    </div>

    <span
      class="rounded-full border border-green-500/30 bg-green-500/10 px-3 py-1 text-xs font-medium text-green-400"
    >
      Verified
    </span>
  </div>

  <div class="mt-5 space-y-2 text-slate-400">
    <p>
      <span class="font-medium text-slate-300">Issuer:</span>
      {issuer}
    </p>

    <p>
      <span class="font-medium text-slate-300">Date:</span>
      {date}
    </p>
  </div>

  <p class="mt-5 leading-7 text-slate-400">
    {description}
  </p>

  {
    certificateUrl && (
      <a
        href={certificateUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-auto pt-6 font-semibold text-cyan-400 transition hover:text-cyan-300"
      >
        View certificate →
      </a>
    )
  }
</article>