---
interface Props {
  title: string;
  status: string;
  description: string;
  tags: string[];
}

const { title, status, description, tags } = Astro.props;
---

<article
  class="card-hover flex h-full flex-col rounded-xl border border-slate-800 bg-slate-900 p-6"
>
  <p class="text-sm font-semibold uppercase tracking-wider text-green-400">
    {status}
  </p>

  <h3 class="mt-3 text-2xl font-semibold text-white">
    {title}
  </h3>

  <p class="mt-4 max-w-2xl leading-7 text-slate-400">
    {description}
  </p>

  <div class="mt-5 flex flex-wrap gap-2">
    {tags.map((tag) => (
      <span
        class="rounded-full border border-slate-700 px-3 py-1 text-xs text-slate-300"
      >
        {tag}
      </span>
    ))}
  </div>
</article>